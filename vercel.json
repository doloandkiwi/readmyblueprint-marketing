{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "readmyblueprint-marketing.vercel.app"
        }
      ],
      "destination": "https://www.readmyblueprint.com/:path*",
      "permanent": true
    },
    {
      "source": "/go",
      "destination": "/send-plans?utm_source=cold_email&utm_medium=email&utm_campaign=outreach_go&utm_content=send_plans",
      "permanent": false
    },
    {
      "source": "/go/tour",
      "destination": "/tour?utm_source=cold_email&utm_medium=email&utm_campaign=outreach_go&utm_content=tour",
      "permanent": false
    },
    {
      "source": "/go/home",
      "destination": "/?utm_source=cold_email&utm_medium=email&utm_campaign=outreach_go&utm_content=home",
      "permanent": false
    },
    {
      "source": "/1/:path*",
      "destination": "/?utm_source=cold_email&utm_medium=email&utm_campaign=prospect_outreach_2026&utm_content=tracking_fallback#pricing",
      "permanent": false
    },
    {
      "source": "/takeoff-software-without-subscription",
      "destination": "/send-plans",
      "permanent": true
    },
    {
      "source": "/takeoff-software-without-subscription.html",
      "destination": "/send-plans",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/p/:token([a-f0-9]{12})",
      "destination": "/p/:token.html"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "destination": "/:slug.html"
    }
  ]
}